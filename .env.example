APP_NAME="Guised Up API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_PORT=8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_PORT_FORWARD=5432
DB_DATABASE=guised_up
DB_USERNAME=guised_up
DB_PASSWORD=guised_up_password
FEED_DEBUG_ENABLED=false
FEED_PROFILE_REBUILD_CONNECTION=deferred
QUEUE_CONNECTION=deferred

EMBEDDING_SERVICE_URL=http://embedding-service:8001
EMBEDDING_SERVICE_PORT=8001
EMBEDDING_MODE=fallback
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ALLOW_FALLBACK_ON_FAILURE=true
EMBEDDING_CONNECT_TIMEOUT=2
EMBEDDING_REQUEST_TIMEOUT=5

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
